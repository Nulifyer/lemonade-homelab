          "429": {
            "description": "Admission queue full."
          },
          "502": {
            "description": "Backend unavailable. Start a fresh request."
          }
        }
      }
    },
    "/v1/audio/transcriptions": {
      "post": {
        "summary": "Transcribe a completed English WAV utterance.",
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "required": [
                  "model",
                  "file"
                ],
                "properties": {
                  "model": {
                    "type": "string"
                  },
                  "file": {
                    "type": "string",
                    "format": "binary",
                    "description": "RIFF WAV upload, at most 16 MiB."
                  },
                  "language": {
                    "type": "string",
                    "default": "en"
                  },
                  "response_format": {
                    "type": "string",
                    "default": "json"
                  }
                },
                "additionalProperties": true
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Model response or streamed response."
          },
          "400": {
            "description": "Invalid request."
          },
          "401": {
            "description": "API key required in key mode."
          },
          "403": {
            "description": "Model or operation denied."
          },
          "413": {
            "description": "Request too large."
          },
          "429": {
            "description": "Admission queue full."
          },
          "502": {
            "description": "Backend unavailable. Start a fresh request."
          }
        }
      }
    },
    "/v1/audio/speech": {
      "post": {
        "summary": "Generate English utility speech.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "model",
                  "input"
                ],
                "properties": {
                  "model": {
                    "type": "string"
                  },
                  "input": {
                    "type": "string"
                  },
                  "voice": {
                    "type": "string",
                    "default": "af_heart"
                  },
                  "response_format": {
                    "type": "string"
                  }
                },
                "additionalProperties": true
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Model response or streamed response."
          },
          "400": {
            "description": "Invalid request."
          },
          "401": {
            "description": "API key required in key mode."
          },
          "403": {
            "description": "Model or operation denied."
          },
          "413": {
            "description": "Request too large."
          },
          "429": {
            "description": "Admission queue full."
          },
          "502": {
            "description": "Backend unavailable. Start a fresh request."
          }
        }
      }
    },
