{
  "openapi": "3.0.3",
  "info": {
    "title": "Lemonade model services",
    "version": "1",
    "description": "Native consumer APIs share Lemonade model state and saved configuration. Explicit client sampling values override presets. Model administration uses the manager listener. Wyoming is private."
  },
  "servers": [],
  "security": [],
  "paths": {
    "/v1/models": {
      "get": {
        "summary": "List approved model aliases. Discovery does not establish model readiness.",
        "responses": {
          "200": {
            "description": "Successful response."
          }
        }
      }
    },
    "/api/tags": {
      "get": {
        "summary": "Ollama model discovery.",
        "responses": {
          "200": {
            "description": "Successful response."
          }
        }
      }
    },
    "/api/version": {
      "get": {
        "summary": "Ollama compatibility version.",
        "responses": {
          "200": {
            "description": "Successful response."
          }
        }
      }
    },
    "/health": {
      "get": {
        "summary": "Interface liveness.",
        "responses": {
          "200": {
            "description": "Successful response."
          }
        }
      }
    },
    "/ready": {
      "get": {
        "summary": "Live readiness of all three critical Home Assistant models.",
        "responses": {
          "200": {
            "description": "Every critical backend is loaded, healthy and pinned."
          },
          "503": {
            "description": "Manager unavailable, or a critical model is missing, unhealthy or unpinned."
          }
        }
      }
    },
    "/metrics": {
      "get": {
        "summary": "Prometheus request and failure counters.",
        "responses": {
          "200": {
            "description": "Successful response."
          }
        }
      }
    },
    "/v1/chat/completions": {
      "post": {
        "summary": "Chat and tool calling.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "model",
                  "messages"
                ],
                "properties": {
                  "model": {
                    "type": "string"
                  },
                  "messages": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "additionalProperties": true
                    }
                  },
                  "stream": {
                    "type": "boolean",
                    "default": false
                  },
                  "temperature": {
                    "type": "number"
                  },
                  "top_p": {
                    "type": "number"
                  },
                  "min_p": {
                    "type": "number"
                  },
                  "repeat_penalty": {
                    "type": "number"
                  },
                  "presence_penalty": {
                    "type": "number"
                  },
                  "frequency_penalty": {
                    "type": "number"
                  },
                  "top_k": {
                    "type": "integer"
                  },
                  "max_tokens": {
                    "type": "integer"
                  }
                },
                "additionalProperties": true
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Model response or streamed response."
          },
          "400": {
            "description": "Invalid request."
          },
          "401": {
            "description": "API key required in key mode."
          },
          "403": {
            "description": "Model or operation denied."
          },
          "413": {
            "description": "Request too large."
          },
          "429": {
            "description": "Admission queue full."
          },
          "502": {
            "description": "Backend unavailable. Start a fresh request."
          }
        }
      }
    },
    "/v1/completions": {
      "post": {
        "summary": "Text completions.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "model",
                  "prompt"
                ],
                "properties": {
                  "model": {
                    "type": "string"
                  },
                  "prompt": {
                    "type": "string"
                  },
                  "stream": {
                    "type": "boolean"
                  },
                  "temperature": {
                    "type": "number"
                  },
                  "top_p": {
                    "type": "number"
                  },
                  "min_p": {
                    "type": "number"
                  },
                  "repeat_penalty": {
                    "type": "number"
                  },
                  "presence_penalty": {
                    "type": "number"
                  },
                  "frequency_penalty": {
                    "type": "number"
                  },
                  "top_k": {
                    "type": "integer"
                  },
                  "max_tokens": {
                    "type": "integer"
                  }
                },
                "additionalProperties": true
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Model response or streamed response."
          },
          "400": {
            "description": "Invalid request."
          },
          "401": {
            "description": "API key required in key mode."
          },
