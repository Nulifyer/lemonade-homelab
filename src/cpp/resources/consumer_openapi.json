          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "model",
                  "input"
                ],
                "properties": {
                  "model": {
                    "type": "string"
                  },
                  "input": {},
                  "stream": {
                    "type": "boolean"
                  },
                  "temperature": {
                    "type": "number"
                  },
                  "top_p": {
                    "type": "number"
                  },
                  "min_p": {
                    "type": "number"
                  },
                  "repeat_penalty": {
                    "type": "number"
                  },
                  "presence_penalty": {
                    "type": "number"
                  },
                  "frequency_penalty": {
                    "type": "number"
                  },
                  "top_k": {
                    "type": "integer"
                  },
                  "max_tokens": {
                    "type": "integer"
                  }
                },
                "additionalProperties": true
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Model response or streamed response."
          },
          "400": {
            "description": "Invalid request."
          },
          "401": {
            "description": "API key required in key mode."
          },
          "403": {
            "description": "Model or operation denied."
