    "/api/chat": {
      "post": {
        "summary": "Ollama chat for Home Assistant and other clients.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "model",
                  "messages"
                ],
                "properties": {
                  "model": {
                    "type": "string"
                  },
                  "messages": {
                    "type": "array",
                    "items": {
                      "type": "object"
                    }
                  },
                  "options": {
                    "type": "object",
                    "description": "Sampling options and num_ctx/num_predict."
                  },
                  "stream": {
                    "type": "boolean"
                  }
                },
                "additionalProperties": true
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Model response or streamed response."
          },
          "400": {
            "description": "Invalid request."
          },
          "401": {
            "description": "API key required in key mode."
          },
          "403": {
            "description": "Model or operation denied."
          },
          "413": {
            "description": "Request too large."
          },
          "429": {
            "description": "Admission queue full."
          },
          "502": {
            "description": "Backend unavailable. Start a fresh request."
          }
        }
      }
    },
    "/api/show": {
      "post": {
        "summary": "Ollama model metadata.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "model"
                ],
                "properties": {
                  "model": {
                    "type": "string"
                  }
                },
                "additionalProperties": true
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Model response or streamed response."
          },
          "400": {
            "description": "Invalid request."
          },
          "401": {
            "description": "API key required in key mode."
          },
          "403": {
            "description": "Model or operation denied."
          },
          "413": {
            "description": "Request too large."
