+describe('loadEphemeralAgent conversation tool defaults', () => {
+  test.each([
+    { selected: undefined, expected: true },
+    { selected: true, expected: true },
+    { selected: false, expected: false },
+  ])('respects explicit Search/Skills choice $selected', async ({ selected, expected }) => {
+    const req = {
+      ...baseReq,
+      body: { ephemeralAgent: { web_search: selected, skills: selected } },
+      config: {
+        modelSpecs: {
+          list: [{ name: 'tools-default', label: 'Tools', webSearch: true, skills: true }],
+        },
+      },
+    } as unknown as Parameters<typeof loadEphemeralAgent>[0]['req'];
